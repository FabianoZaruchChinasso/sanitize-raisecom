{
  "ready_prompt": "#",
  "login": [
    {"expect": "ame: ", "send": "{username}"},
    {"expect": "ord: ", "send": "{password}"}
  ],
  "operations": {
    "sanitize": [
      {"expect": "#", "send": "boot startup-config backup"},
      {"expect": "y/n):", "send": "reboot"},
      {"expect": null, "send": "y"}
    ],
    "reboot": [
      {"expect": "#", "send": "boot startup-config main"},
      {"expect": "y/n):", "send": "reboot"},
      {"expect": null, "send": "y"}
    ],
    "upload": [
      {"expect": "#", "send": "ftp put {ftp_host} {ftp_user} {ftp_pass} {filename} running-config"}
    ],
    "download": [
      {"expect": "#", "send": "ftp get {ftp_host} {ftp_user} {ftp_pass} {filename} localfile backup.cfg"},
      {"expect": "#", "send": "copy downloads/backup.cfg start.cfg"},
      {"expect": "#", "send": "configure"},
      {"expect": "y/n):", "send": "upgrade config localfile start.cfg"},
      {"expect": "config)#", "send": "y", "timeout": 300},
      {"expect": "#", "send": "exit"}
    ]
  }
}
